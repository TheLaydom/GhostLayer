# Copy to extension/.env.local and fill in your Firebase project config.
# Never commit .env or .env.local.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Supported Gemini cloud model via Firebase AI Logic (only receives sanitized prompts).
# Verify current model IDs at https://firebase.google.com/docs/ai-logic/models
VITE_FIREBASE_CLOUD_MODEL=gemini-3.5-flash

# App Check Debug Token (required for MV3 extension dev because MV3 CSP blocks remote reCAPTCHA scripts).
# Register in Firebase Console -> Security -> App Check -> Apps -> Manage debug tokens.
VITE_FIREBASE_APPCHECK_DEBUG_TOKEN=

# Optional: reCAPTCHA Enterprise site key (used only in standalone non-extension web builds).
VITE_FIREBASE_RECAPTCHA_ENTERPRISE_SITE_KEY=
