# Copy to extension/.env.local and fill in your Firebase project config.
# Never commit .env or .env.local.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Supported Gemini cloud model via Firebase AI Logic (only receives sanitized prompts).
# Verify current model IDs at https://firebase.google.com/docs/ai-logic/models
VITE_FIREBASE_CLOUD_MODEL=gemini-3.5-flash

# Production MV3 App Check CustomProvider broker URL (see workers/appcheck-broker/).
# When set, EVERY user gets automatic App Check tokens with zero manual debug tokens.
VITE_FIREBASE_APPCHECK_BROKER_URL=

# Local development App Check debug mode (boolean flag ONLY — NEVER put a debug token in Vite env vars,
# because Vite embeds VITE_* strings into distributed JS bundles).
# When true, Firebase generates a private runtime debug token in your browser DevTools console
# that you register in Firebase Console -> Security -> App Check -> Apps -> Manage debug tokens.
VITE_FIREBASE_APPCHECK_DEBUG_MODE=false

# Optional: reCAPTCHA Enterprise site key (used only in standalone non-MV3 web builds).
VITE_FIREBASE_RECAPTCHA_ENTERPRISE_SITE_KEY=
